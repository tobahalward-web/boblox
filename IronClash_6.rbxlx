local HIP_R = { rsx = -35, rsy = 88, rsz = -13, rex = 114 }

local function with(base, ...)
	local p = P(nil, base)
	for _, t in ipairs({ ... }) do
		for k, v in pairs(t) do
			p[k] = v
		end
	end
	return p
end

