------------------------------------------------------------------------------------------
-- attack clips (windup -> strike -> follow-through -> guard)
------------------------------------------------------------------------------------------
local defs = {}

-- 1: lead jab
local jabLoad = P({ ry = -24, py = -0.36, nx = 8, lsx = 64, lsy = -8, lex = 114 })
local jabOut = P({ rx = -7, ry = -46, py = -0.4, wx = -10, wy = 2, nx = 6, ny = 40,
